{
  "name": "signalhire-mcp-server",
  "version": "1.0.0",
  "description": "Production-grade Model Context Protocol (MCP) server for SignalHire API",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "signalhire-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http --port 3333",
    "test": "node --test dist/__tests__/*.test.js"
  },
  "keywords": [
    "signalhire",
    "mcp",
    "model-context-protocol",
    "recruitment",
    "sourcing",
    "candidate-search",
    "email-finder",
    "talent-acquisition"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.7.3"
  }
}
